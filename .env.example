# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/multitech_db?schema=public"

# Authentication Secret (Generate random string min 32 chars)
AUTH_SECRET="replace_with_random_hex_secret_min_32_chars"

# Set "true" only if running without PostgreSQL database in offline fallback mode
ALLOW_OFFLINE_ADMIN_FALLBACK="false"

# Hostnames & URLs for Subdomain Routing
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://admin.localhost:3000"
NEXT_PUBLIC_WORKSHOP_WA="6281234567890"

# Media Storage Directory (Relative or Absolute path)
MEDIA_STORAGE_PATH="./media"
